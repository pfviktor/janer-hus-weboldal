---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { siteConfig } from '../config/site';
---

<BaseLayout
  title={`Köszönjük megkeresését! – ${siteConfig.businessName}`}
  description="Üzenetét sikeresen megkaptuk, hamarosan felvesszük Önnel a kapcsolatot."
>
  <Header slot="header" />

  <section class="section" style="min-height:65vh; display:flex; align-items:center; text-align:center;">
    <div class="container" style="max-width:620px;">
      <div style="font-size:3.5rem; margin-bottom:1rem;">✅</div>
      <h1 style="font-size:2.2rem; margin-bottom:1rem; color:var(--color-primary);">Köszönjük megkeresését!</h1>
      <p style="font-size:1.1rem; line-height:1.7; margin-bottom:2rem;">
        Üzenete sikeresen megérkezett hozzánk. Munkatársunk a megadott elérhetőségeken hamarosan felveszi Önnel a kapcsolatot!
      </p>
      <a href="/" class="btn btn--primary">
        Vissza a főoldalra →
      </a>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>

