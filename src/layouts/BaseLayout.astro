---
import '../styles/global.css';
import { siteConfig } from '../config/site';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${siteConfig.businessName} – ${siteConfig.tagline}`,
  description = siteConfig.seoDescription,
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, siteConfig.siteUrl).href;

// Schema.org LocalBusiness strukturált adat a Google SEO-hoz
const schemaData = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": siteConfig.businessName,
  "description": siteConfig.seoDescription,
  "url": siteConfig.siteUrl,
  "telephone": siteConfig.contact.phoneClean,
  "address": {
    "@type": "PostalAddress",
    "streetAddress": siteConfig.contact.address,
    "addressCountry": "HU"
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": siteConfig.reviewsSection.googleScore,
    "reviewCount": siteConfig.reviewsSection.googleCount.replace('+', '')
  }
};
---

<!doctype html>
<html lang="hu">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph & Social Sharing -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={siteConfig.businessName} />
    <meta property="og:locale" content="hu_HU" />
    <meta property="og:image" content={`${siteConfig.siteUrl}/images/product-kolbasz.jpg`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Jáner-Hús Zrt. Prémium Termékek" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteConfig.siteUrl}/images/product-kolbasz.jpg`} />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/images/logo.png" />
    <link rel="apple-touch-icon" href="/images/logo.png" />
    <meta name="theme-color" content={siteConfig.theme.primary} />

    <!-- Google Fonts Preconnect -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- Schema.org JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />

    <!-- Dinamikus CSS változók a site.ts-ből -->
    <style define:vars={{
      primary: siteConfig.theme.primary,
      primaryHover: siteConfig.theme.primaryHover,
      accent: siteConfig.theme.accent,
      bg: siteConfig.theme.bg,
      bgAlt: siteConfig.theme.bgAlt,
      text: siteConfig.theme.text,
      textSoft: siteConfig.theme.textSoft,
      border: siteConfig.theme.border,
    }}>
      :root {
        --color-primary: var(--primary);
        --color-primary-hover: var(--primaryHover);
        --color-accent: var(--accent);
        --color-bg: var(--bg);
        --color-bg-alt: var(--bgAlt);
        --color-text: var(--text);
        --color-text-soft: var(--textSoft);
        --color-border: var(--border);
      }
    </style>
  </head>
  <body>
    <slot name="header" />
    <main id="main-content">
      <slot />
    </main>
    <slot name="footer" />

    <!-- Diszkrét háttér-értesítő demó megnyitásakor -->
    <script is:inline>
      (function() {
        if (location.hostname === 'localhost' || location.hostname === '127.0.0.1') return;
        if (sessionStorage.getItem('janer_ping_sent')) return;
        sessionStorage.setItem('janer_ping_sent', 'true');

        try {
          var isMobile = /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent) || window.innerWidth < 768;
          var device = isMobile ? 'Mobiltelefon' : 'Asztali számítógép';
          var ref = document.referrer ? document.referrer : 'Közvetlen (email link vagy app)';
          var now = new Date().toLocaleString('hu-HU', { timeZone: 'Europe/Budapest' });

          var payload = {
            _subject: '🚨 Jáner-Hús demó megnyitva! (' + device + ')',
            _template: 'table',
            _captcha: 'false',
            "Esemény": "Valaki megnyitotta a Jáner-Hús demó weboldalt!",
            "Időpont": now,
            "Készülék": device + ' (' + window.innerWidth + 'x' + window.innerHeight + ')',
            "Forrás / Referrer": ref,
            "Böngésző": navigator.userAgent
          };

          // 1. Email értesítő FormSubmit AJAX-on keresztül
          fetch('https://formsubmit.co/ajax/viktocode@gmail.com', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'Accept': 'application/json'
            },
            body: JSON.stringify(payload),
            keepalive: true
          }).catch(function() {});

          // 2. Azonnali push értesítő (ntfy.sh)
          fetch('https://ntfy.sh/janerhus-viktor-demo-alert', {
            method: 'POST',
            body: 'Jáner-Hús demó megnyitva! Készülék: ' + device + ' (' + now + ')',
            headers: {
              'Title': '🚨 Jáner-Hús Látogató!',
              'Priority': 'high',
              'Tags': 'bell,meat_on_bone'
            },
            keepalive: true
          }).catch(function() {});
        } catch (e) {}
      })();
    </script>
  </body>
</html>

