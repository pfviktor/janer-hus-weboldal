---
import { siteConfig } from '../config/site';
---

<section id="kapcsolat" class="section" aria-labelledby="contact-title">
  <div class="container">
    <div class="section-header">
      {siteConfig.contact.badge && (
        <span class="section-badge">{siteConfig.contact.badge}</span>
      )}
      <h2 id="contact-title">{siteConfig.contact.title}</h2>
      <p>{siteConfig.contact.subtitle}</p>
    </div>

    <div class="contact-grid">
      <!-- Bal oldal: Elérhetőségek & Címek -->
      <div>
        <div class="contact-card">
          <h3 style="margin-bottom:1rem; color:var(--color-text);">Központi Elérhetőségek</h3>
          <p style="font-size:0.95rem; margin-bottom:1.5rem;">
            Kérdéseivel, rendeléseivel és B2B nagykereskedelmi partnerséggel kapcsolatban forduljon hozzánk bizalommal!
          </p>

          <div class="contact-info-list">
            <!-- Telefonok -->
            <div class="contact-info-item">
              <div class="contact-svg-box">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                </svg>
              </div>
              <div>
                <div class="contact-info-label">Rendelésfelvétel & Ügyfélszolgálat</div>
                <div class="contact-info-val">
                  <a href={`tel:${siteConfig.contact.phoneClean}`} style="color:var(--color-primary); font-weight:700;">
                    {siteConfig.contact.phone}
                  </a>
                  <span style="color:var(--color-border); margin:0 0.4rem;">|</span>
                  <a href={`tel:${siteConfig.contact.phoneSecondaryClean}`} style="color:var(--color-primary); font-weight:700;">
                    {siteConfig.contact.phoneSecondary}
                  </a>
                </div>
                <div style="font-size:0.85rem; color:var(--color-text-soft); margin-top:0.25rem;">
                  Mobil: <a href={`tel:${siteConfig.contact.phoneMobileClean}`} style="color:var(--color-text); font-weight:600;">{siteConfig.contact.phoneMobile}</a>
                </div>
              </div>
            </div>

            <!-- Emailek -->
            <div class="contact-info-item">
              <div class="contact-svg-box">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                  <polyline points="22,6 12,13 2,6"></polyline>
                </svg>
              </div>
              <div>
                <div class="contact-info-label">E-mail címeink</div>
                <div class="contact-info-val">
                  <a href={`mailto:${siteConfig.contact.email}`} style="color:var(--color-primary); font-weight:700;">
                    {siteConfig.contact.email}
                  </a>
                  <div style="font-size:0.85rem; color:var(--color-text-soft); margin-top:0.15rem;">
                    {siteConfig.contact.emailSupport}
                  </div>
                </div>
              </div>
            </div>

            <!-- Üzemek & Központ -->
            <div class="contact-info-item">
              <div class="contact-svg-box">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                  <circle cx="12" cy="10" r="3"></circle>
                </svg>
              </div>
              <div>
                <div class="contact-info-label">Központ & Óbudai Mintabolt</div>
                <div class="contact-info-val">1036 Budapest, Pacsirtamező utca 22.</div>
                <div style="font-size:0.85rem; color:var(--color-text-soft); margin-top:0.15rem;">Bolt telefon: (06 1) 367 5630</div>
              </div>
            </div>

            <div class="contact-info-item">
              <div class="contact-svg-box">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M2 20h20M7 20v-8a2 2 0 0 1 2-2h6a2 2 0 0 1 2 2v8M9 4l3-2 3 2v6H9V4z"></path>
                </svg>
              </div>
              <div>
                <div class="contact-info-label">Húsbontó & Húsnagykereskedés (HU 387 EK)</div>
                <div class="contact-info-val">1138 Budapest, Dugonics utca 15.</div>
              </div>
            </div>

            <div class="contact-info-item">
              <div class="contact-svg-box">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M2 20h20M7 20v-8a2 2 0 0 1 2-2h6a2 2 0 0 1 2 2v8M9 4l3-2 3 2v6H9V4z"></path>
                </svg>
              </div>
              <div>
                <div class="contact-info-label">Húsfeldolgozó Üzem (HU 495 EK)</div>
                <div class="contact-info-val">2310 Szigetszentmiklós, Lehel út 9.</div>
              </div>
            </div>
          </div>

          <!-- Nyitvatartási összefoglaló -->
          <div style="border-top:1px solid var(--color-border); padding-top:1.25rem; margin-top:1.5rem;">
            <h4 style="font-size:0.95rem; font-weight:700; margin-bottom:0.75rem;">Főbb nyitvatartási rendek:</h4>
            <ul style="font-size:0.88rem; line-height:1.7;">
              {siteConfig.contact.hours.map((h) => (
                <li style="display:flex; flex-direction:column; border-bottom:1px dashed var(--color-border); padding:0.35rem 0;">
                  <span style="font-weight:600; color:var(--color-text);">{h.days}</span>
                  <span style="color:var(--color-primary); font-weight:700;">{h.time}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>

      <!-- Jobb oldal: FormSubmit űrlap -->
      <div>
        <div class="contact-card">
          <h3 style="margin-bottom:0.5rem; color:var(--color-text);">Online Üzenetküldés & Árajánlatkérés</h3>
          <p style="font-size:0.95rem; margin-bottom:1.5rem;">
            Töltse ki az űrlapot éttermi/B2B árajánlatkéréshez vagy lakossági előrendeléshez, munkatársunk hamarosan visszahívja.
          </p>

          <form
            id="contact-form"
            action={`https://formsubmit.co/${siteConfig.contact.formSubmitEmail}`}
            method="POST"
          >
            <!-- FormSubmit beállítások -->
            <input type="hidden" name="_subject" value={`Új weboldalas megkeresés – ${siteConfig.businessName}`} />
            <input type="hidden" name="_template" value="table" />
            <input type="hidden" name="_captcha" value="false" />
            <input type="hidden" name="_next" value={`${siteConfig.siteUrl}/koszonom`} />

            <!-- Honeypot spamcsapda -->
            <input type="text" name="_honey" style="display:none;" />

            <div class="form-group">
              <label for="name">Az Ön neve / Cég neve *</label>
              <input type="text" id="name" name="Név" placeholder="Pl. Kovács Péter (vagy Cég/Étterem neve)" required autocomplete="name" />
            </div>

            <div class="form-group">
              <label for="phone">Telefonszáma *</label>
              <input type="tel" id="phone" name="Telefonszám" placeholder="Pl. +36 30 123 4567" required autocomplete="tel" />
            </div>

            <div class="form-group">
              <label for="email">E-mail címe *</label>
              <input type="email" id="email" name="Email" placeholder="peter@pelda.hu" required autocomplete="email" />
            </div>

            <div class="form-group">
              <label for="service">Megkeresés típusa *</label>
              <select id="service" name="Típus" required>
                <option value="">Kérjük válasszon...</option>
                <option value="B2B Nagykereskedelmi árajánlat (HORECA / Étterem)">B2B Nagykereskedelmi árajánlat (HORECA / Étterem)</option>
                <option value="Konyhakész egyedi húsbontás séfeknek">Konyhakész egyedi húsbontás séfeknek</option>
                <option value="Lakossági előrendelés – Óbuda (Pacsirtamező u.)">Lakossági előrendelés – Óbudai Mintabolt</option>
                <option value="Lakossági érdeklődés – Isaszegi Mintabolt">Lakossági érdeklődés – Isaszegi Mintabolt</option>
                <option value="Lakossági érdeklődés – Monori Mintabolt (Tesco)">Lakossági érdeklődés – Monori Mintabolt (Tesco)</option>
                <option value="Lakossági érdeklődés – Dunakeszi Mintabolt (Tesco)">Lakossági érdeklődés – Dunakeszi Mintabolt (Tesco)</option>
                <option value="Egyéb üzleti / észrevétel">Egyéb üzleti / észrevétel</option>
              </select>
            </div>

            <div class="form-group">
              <label for="message">Üzenet vagy tételes rendelési igény</label>
              <textarea id="message" name="Üzenet" placeholder="Írja le a kívánt mennyiséget, termékeket, vagy a kiszállítás/átvétel tervezett időpontját..."></textarea>
            </div>

            <button type="submit" class="btn btn--primary" style="width:100%; font-size:1rem; padding:0.85rem 1.5rem;">
              Üzenet és Igény Elküldése →
            </button>
          </form>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .contact-svg-box {
    width: 38px;
    height: 38px;
    border-radius: var(--radius-sm);
    background: rgba(139, 30, 30, 0.08);
    color: var(--color-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .contact-svg-box svg {
    width: 18px;
    height: 18px;
  }
</style>
