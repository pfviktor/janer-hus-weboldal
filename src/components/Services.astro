---
import { siteConfig } from '../config/site';
---

<section id="termekek" class="section section--alt" aria-labelledby="services-title">
  <div class="container">
    <div class="section-header">
      {siteConfig.servicesSection.badge && (
        <span class="section-badge">{siteConfig.servicesSection.badge}</span>
      )}
      <h2 id="services-title">{siteConfig.servicesSection.title}</h2>
      <p>{siteConfig.servicesSection.subtitle}</p>
    </div>

    <!-- Termékek kártyarács valódi fotókkal -->
    <div class="services-grid">
      {siteConfig.servicesSection.items.map((item) => (
        <div class="service-card">
          <div class="service-card__img-wrap">
            <img src={item.image} alt={item.title} class="service-card__img" loading="lazy" />
            {item.badge && <span class="service-card__badge">{item.badge}</span>}
          </div>

          <div class="service-card__content">
            <h3 class="service-card__title">{item.title}</h3>
            <p class="service-card__desc">{item.description}</p>
            <div class="service-card__footer">
              <div class="service-card__price-wrap">
                <span class="service-card__price-label">Ellátás:</span>
                <span class="service-card__price-val">{item.price || 'Friss vágásból'}</span>
              </div>
              <a href="#kapcsolat" class="btn btn--outline service-card__btn">
                Érdeklődés →
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Hivatalos dokumentumok & Képes Terméklista sáv -->
    <div class="docs-download-box">
      <div class="docs-download-box__left">
        <div class="docs-icon-wrap">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
            <polyline points="14 2 14 8 20 8"></polyline>
            <line x1="16" y1="13" x2="8" y2="13"></line>
            <line x1="16" y1="17" x2="8" y2="17"></line>
            <polyline points="10 9 9 9 8 9"></polyline>
          </svg>
        </div>
        <div>
          <h4 style="margin:0 0 0.25rem 0; font-size:1.1rem; color:var(--color-text);">
            Hivatalos Tájékoztatók & Allergén Táblázat
          </h4>
          <p style="margin:0; font-size:0.9rem; color:var(--color-text-soft);">
            A Jáner-Hús Zrt. által forgalmazott termékek hivatalos összetevő- és allergén kimutatása PDF formátumban.
          </p>
        </div>
      </div>
      <div class="docs-download-box__right">
        <a
          href={siteConfig.servicesSection.allergenPdfUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn--primary"
          style="display:inline-flex; align-items:center; gap:0.5rem; font-size:0.88rem;"
        >
          Allergén Táblázat Letöltése (PDF) ↓
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.75rem;
  }

  .service-card {
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
    display: flex;
    flex-direction: column;
  }

  .service-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
    border-color: var(--color-primary);
  }

  .service-card__img-wrap {
    position: relative;
    height: 180px;
    width: 100%;
    overflow: hidden;
    background: var(--color-bg);
  }

  .service-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .service-card:hover .service-card__img {
    transform: scale(1.05);
  }

  .service-card__badge {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    background: rgba(139, 30, 30, 0.9);
    color: #FFFFFF;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-full);
    backdrop-filter: blur(4px);
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.2);
  }

  .service-card__content {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .service-card__title {
    font-size: 1.15rem;
    margin-bottom: 0.6rem;
    color: var(--color-text);
  }

  .service-card__desc {
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--color-text-soft);
    margin-bottom: 1.5rem;
    flex-grow: 1;
  }

  .service-card__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-border);
    margin-top: auto;
  }

  .service-card__price-wrap {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .service-card__price-label {
    font-size: 0.72rem;
    text-transform: uppercase;
    color: var(--color-text-soft);
    font-weight: 600;
    letter-spacing: 0.04em;
    line-height: 1;
    margin-bottom: 3px;
  }

  .service-card__price-val {
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--color-primary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .service-card__btn {
    padding: 0.5rem 1rem;
    font-size: 0.84rem;
    font-weight: 700;
    flex-shrink: 0;
    white-space: nowrap;
  }

  @media (max-width: 380px) {
    .service-card__footer {
      flex-direction: column;
      align-items: stretch;
      gap: 0.75rem;
    }

    .service-card__btn {
      width: 100%;
      text-align: center;
      justify-content: center;
    }
  }

  .docs-download-box {
    margin-top: 3rem;
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 1.5rem 2rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    box-shadow: var(--shadow-sm);
  }

  .docs-download-box__left {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .docs-icon-wrap {
    width: 46px;
    height: 46px;
    border-radius: var(--radius-sm);
    background: rgba(139, 30, 30, 0.08);
    color: var(--color-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
</style>
