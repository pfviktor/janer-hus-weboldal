---
import { siteConfig } from '../config/site';
---

<section id="partnerek" class="section section--alt" aria-labelledby="partners-title">
  <div class="container">
    <div class="section-header">
      {siteConfig.partnersSection.badge && (
        <span class="section-badge">{siteConfig.partnersSection.badge}</span>
      )}
      <h2 id="partners-title">{siteConfig.partnersSection.title}</h2>
      <p style="max-width: 68ch; margin: 0.75rem auto 0 auto; color: var(--color-text-soft); font-size: 1.05rem;">
        {siteConfig.partnersSection.subtitle}
      </p>
    </div>

    <!-- Partner logók rácsa -->
    <div class="partners-grid">
      {siteConfig.partnersSection.partners.map((partner) => (
        <div class="partner-card" title={partner.name}>
          <div class="partner-card__img-wrap">
            <img
              src={partner.logo}
              alt={`${partner.name} logó - Jáner-Hús partner`}
              loading="lazy"
              class="partner-card__logo"
            />
          </div>
          <span class="partner-card__name">{partner.name}</span>
        </div>
      ))}
    </div>

    <!-- Partner tanúsítvány és ellátási garancia -->
    <div class="partner-trust-banner">
      <div class="partner-trust-icon">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
          <path d="m9 12 2 2 4-4"></path>
        </svg>
      </div>
      <div class="partner-trust-text">
        <h4 style="margin:0 0 0.25rem 0; font-size:1.05rem; color:var(--color-text); font-weight:700;">
          Garantált Eredet & Szigorú Minőségbiztosítás
        </h4>
        <p style="margin:0; font-size:0.9rem; color:var(--color-text-soft); line-height:1.5;">
          Hivatalos és közvetlen gyári kapcsolatban állunk Magyarország legelismertebb húsipari termelőivel. Mintaboltjaink és B2B partnereink kizárólag szigorúan auditált, hűtött láncon érkező árut kapnak.
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .partners-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 1.25rem;
    margin-top: 2rem;
  }

  .partner-card {
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 1.25rem 1rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    box-shadow: var(--shadow-sm);
    transition: all var(--transition);
  }

  .partner-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
    border-color: var(--color-primary);
  }

  .partner-card__img-wrap {
    width: 100%;
    height: 70px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 0.75rem;
    padding: 0.25rem;
  }

  .partner-card__logo {
    max-width: 130px;
    max-height: 60px;
    width: auto;
    height: auto;
    object-fit: contain;
    filter: drop-shadow(0 1px 2px rgba(0,0,0,0.04));
    transition: transform var(--transition);
  }

  .partner-card:hover .partner-card__logo {
    transform: scale(1.05);
  }

  .partner-card__name {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-text);
    letter-spacing: -0.01em;
  }

  .partner-trust-banner {
    margin-top: 2.5rem;
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 1.25rem 1.75rem;
    display: flex;
    align-items: center;
    gap: 1.25rem;
    box-shadow: var(--shadow-sm);
  }

  .partner-trust-icon {
    width: 44px;
    height: 44px;
    border-radius: var(--radius-sm);
    background: rgba(139, 30, 30, 0.08);
    color: var(--color-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  @media (max-width: 640px) {
    .partners-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 0.85rem;
    }

    .partner-card {
      padding: 1rem 0.75rem;
    }

    .partner-card__img-wrap {
      height: 55px;
    }

    .partner-card__logo {
      max-width: 105px;
      max-height: 48px;
    }

    .partner-trust-banner {
      flex-direction: column;
      align-items: flex-start;
      padding: 1.25rem;
      gap: 0.75rem;
    }
  }
</style>

